# Copie ce fichier en .env.local puis remplace les valeurs.
# Le front-end seul ne peut pas envoyer un e-mail silencieusement.
# Configure cette URL vers ton endpoint serverless/back-end d'envoi mail.
VITE_MAIL_API_ENDPOINT=https://ton-domaine.com/api/send-ticket-email
VITE_TICKETING_RECIPIENT=billetterie@ton-domaine.com
