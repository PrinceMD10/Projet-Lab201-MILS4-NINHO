# Copie ce fichier en .env.local localement ou configure ces variables
# dans les variables d'environnement de l'hébergeur.

# Back-office admin. Utilise un identifiant non évident et un mot de passe long.
ADMIN_USERNAME=change-moi
ADMIN_PASSWORD=remplace-par-un-mot-de-passe-long-unique

# Génère une clé forte, par exemple : openssl rand -base64 48
JWT_SECRET=remplace-par-une-cle-aleatoire-de-48-octets-minimum

# Endpoint optionnel si tu ajoutes un service d'e-mail côté serveur.
VITE_MAIL_API_ENDPOINT=https://ton-domaine.com/api/send-ticket-email
VITE_TICKETING_RECIPIENT=billetterie@ton-domaine.com
